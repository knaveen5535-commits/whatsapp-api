meta {
  name: Update Template
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/templates/{{templateId}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "name": "greeting",
    "body": "Hi {{name}}, welcome to our service!"
  }
}

