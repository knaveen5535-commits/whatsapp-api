meta {
  name: Update Template
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/templates/{{templateId}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "name": "greeting",
    "content": "Hi {{name}}, welcome to our service!",
    "language": "en"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
  apiKey: 80d875d73cf6fce949766f1d447c82766f0efc054b5fc07b6d5c89d539df11f8
}
