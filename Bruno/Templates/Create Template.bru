meta {
  name: Create Template
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/templates
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "name": "greeting",
    "body": "Hello {{name}}, welcome!"
  }
}

