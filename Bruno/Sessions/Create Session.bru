meta {
  name: Create Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "sessionId": "my-session"
  }
}

vars:pre-request {
  baseUrl: '''
    http://localhost:2785
    
  '''
}
