meta {
  name: Send Product
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-product
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "chatId": "{{chatId}}",
    "productId": "{{productId}}",
    "body": "Check this product"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
