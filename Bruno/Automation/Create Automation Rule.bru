meta {
  name: Create Automation Rule
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/automation-rules
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "name": "Auto Reply",
    "enabled": true,
    "conditions": [
      {
        "type": "keyword",
        "operator": "contains",
        "value": "hello"
      }
    ],
    "actions": [
      {
        "type": "reply",
        "message": "Hi there!"
      }
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
