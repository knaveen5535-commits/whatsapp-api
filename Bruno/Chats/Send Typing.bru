meta {
  name: Send Typing
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/chats/typing
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "state": "typing"
  }
}

vars:pre-request {
  apiKey: 80d875d73cf6fce949766f1d447c82766f0efc054b5fc07b6d5c89d539df11f8
}
