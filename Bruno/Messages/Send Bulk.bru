meta {
  name: Send Bulk
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-bulk
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "messages": [
      {
        "chatId": "{{chatId}}",
        "type": "text",
        "text": "Hello from bulk"
      }
    ],
    "options": {
      "delayBetweenMessages": 3000
    }
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
