meta {
  name: Send Template
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-template
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "templateId": "example",
    "parameters": {}
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
