meta {
  name: Send Video
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-video
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "video": "{{videoUrl}}",
    "caption": ""
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
