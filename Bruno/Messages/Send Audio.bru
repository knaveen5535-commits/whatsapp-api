meta {
  name: Send Audio
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-audio
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "audio": "{{audioUrl}}",
    "ptt": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
