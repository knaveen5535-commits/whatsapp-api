meta {
  name: Send Image
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-image
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "url": "https://example.com/image.jpg",
    "caption": "Image caption"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
  apiKey: 80d875d73cf6fce949766f1d447c82766f0efc054b5fc07b6d5c89d539df11f8
}
