meta {
  name: Send Contact
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-contact
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "contacts": [
      {
        "name": "Abishek",
        "phoneNumber": "7904064848"
      }
    ]
  }
}

