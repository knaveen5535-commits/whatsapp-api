meta {
  name: Send Document
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/messages/send-document
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "chatId": "{{chatId}}",
    "document": "{{documentUrl}}",
    "filename": "document.pdf"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
  apiKey: 80d875d73cf6fce949766f1d447c82766f0efc054b5fc07b6d5c89d539df11f8
}
