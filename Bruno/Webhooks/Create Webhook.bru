meta {
  name: Create Webhook
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/webhooks
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "url": "https://example.com/webhook",
    "events": ["message.received", "message.sent"],
    "active": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
