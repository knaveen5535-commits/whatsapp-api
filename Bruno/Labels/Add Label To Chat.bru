meta {
  name: Add Label To Chat
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/labels/chat/{{chatId}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "labelId": "{{labelId}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
