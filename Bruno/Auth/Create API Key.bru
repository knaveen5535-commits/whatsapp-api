meta {
  name: Create API Key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/api-keys
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Test Key",
    "role": "operator"
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
