meta {
  name: Demote Participants
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/groups/{{groupId}}/participants/demote
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "participants": [
      "628123456789@c.us"
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
