meta {
  name: Update Group Settings
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/groups/{{groupId}}/settings
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "announce": false,
    "restrict": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
