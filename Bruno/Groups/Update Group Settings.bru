meta {
  name: Update Group Settings
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/groups/{{groupId}}/settings
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "announce": false,
    "restrict": false
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
  apiKey: 80d875d73cf6fce949766f1d447c82766f0efc054b5fc07b6d5c89d539df11f8
}
