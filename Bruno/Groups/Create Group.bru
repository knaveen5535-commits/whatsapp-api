meta {
  name: Create Group
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/groups
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "title": "My Group",
    "participants": [
      "628123456789@c.us"
    ]
  }
}

vars:pre-request {
  baseUrl: http://localhost:2785
}
